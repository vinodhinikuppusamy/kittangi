{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "build": "pnpm --filter @workspace/scripts run build",
    "build:client": "pnpm --filter @workspace/scripts run build:client",
    "build:server": "pnpm --filter @workspace/scripts run build:server",
    "build:staging": "pnpm --filter @workspace/scripts run build:staging",
    "build:client:staging": "pnpm --filter @workspace/scripts run build:client:staging",
    "build:server:staging": "pnpm --filter @workspace/scripts run build:server:staging",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
